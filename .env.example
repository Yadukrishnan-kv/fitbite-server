# ---------------------------------------------------------------------------
# Fitbite backend environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# Public origin of the React client (used for CORS + cookies).
# In dev this is the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string.
#  - Local:  mongodb://127.0.0.1:27017/fitbite
#  - Atlas:  mongodb+srv://<user>:<pass>@<cluster>/fitbite?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fitbite

# ---- Auth (used from Stage 2 onward) ----
# Generate a long random secret, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=fitbite_token

# ---- Default admin account (created by the seed script) ----
# The password is hashed with bcrypt before storage; it is never stored in plain text.
ADMIN_NAME=Fitbite Admin
ADMIN_EMAIL=admin@fitbite.in
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Login rate limiting ----
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=8
